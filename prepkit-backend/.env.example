# Server
PORT=4000
NODE_ENV=development

# MongoDB - local default works if you have MongoDB running locally.
# For a free cloud option, use MongoDB Atlas and paste its connection string here.
MONGODB_URI=mongodb://127.0.0.1:27017/prepkit

# Used to sign the session cookie. Any long random string in production.
SESSION_SECRET=dev-only-secret-change-me

# Frontend origin allowed to call this API with credentials.
CORS_ORIGIN=http://localhost:3000
